# Configuración de entorno para IDM-VTON
# Valores recomendados para RTX 3060 12GB
# Fuerza ejecución en CPU cuando vale 1. Útil como fallback si CUDA falla o no hay VRAM suficiente.
IDMVTON_FORCE_CPU=0
# Activa offload de módulos a CPU para reducir picos de VRAM durante la inferencia.
IDMVTON_CPU_OFFLOAD=1
# Activa perfil de bajo consumo de memoria (resolución interna menor y carga más estable en 12GB).
IDMVTON_LOW_RAM=1
# Controla si Gradio crea enlace público (1) o se mantiene solo en red/local (0).
IDMVTON_SHARE=0
# Ajuste del asignador CUDA de PyTorch para reducir fragmentación de memoria (mejora estabilidad ante OOM).
PYTORCH_CUDA_ALLOC_CONF=max_split_size_mb:64

# Ruta del dataset preparado para entrenamiento (estructura train/test + vitonhd_*_tagged.json + *_pairs.txt).
DATA_DIR=/home/uceda/Documents/IDM-VTON/dataset/DATA_DIR_PREP
# Carpeta de salida para checkpoints e imágenes de validación de entrenamiento.
OUTPUT_DIR=/home/uceda/Documents/IDM-VTON/result_train
# Parámetros por defecto recomendados para RTX 3060 12GB durante entrenamiento.
TRAIN_BATCH_SIZE=1
TEST_BATCH_SIZE=1
NUM_TRAIN_EPOCHS=130
LOGGING_STEPS=1000
CHECKPOINT_EPOCH=10
MIXED_PRECISION=fp16

# Modelo activo para inferencia/app: MODELO OFICIAL yisol/IDM-VTON.
# DECISION 2026-08-30 (A/B controlado par 048400_0, prenda azul, seed 42, 448x576):
#   - OFICIAL  -> torso AZUL 54% (transfiere la prenda correctamente).
#   - v13-cum800, v12-cum1800 y la antigua "base" (result_train_night) -> torso
#     NEGRO 26-31% + rojo 33-90%, azul 0-4% (NO transfieren la prenda).
# => el fine-tuning actual DEGRADA la transferencia; se revierte al oficial.
# La "base" previa era en realidad un checkpoint heredado de entrenamiento
# (result_train_night <- result_train/checkpoint-100), no el modelo base real.
IDMVTON_MODEL_PATH=yisol/IDM-VTON
