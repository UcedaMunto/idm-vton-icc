# =============================================================================
# config_v14_comercial.env  -  IDM-VTON V14 (2026-09-09)
#
# NO lo lee nada automaticamente. Sirve como:
#   a) referencia documental de la configuracion, y
#   b) variables para lanzar un bloque manual:
#        set -a; source configuracion-v14-entrenamiento/config_v14_comercial.env; set +a
#        bash "entrenamiento continuo/watchdog_entrenamiento.sh"
#
# PISTA A = I+D no comercial con el dataset actual (valores que corren HOY).
# PISTA B = receta propuesta para un modelo comercial; exige dataset y stack con
#           licencia comercial (ver 01/02/03) y NO esta implementada aun.
# =============================================================================

# --- Rutas (PISTA A) ---------------------------------------------------------
PROJECT_ROOT=/home/uceda/Documents/IDM-VTON
DATA_DIR=/home/uceda/Documents/IDM-VTON/dataset/DATA_DIR_PREP
BASE_CHECKPOINT=/home/uceda/Documents/IDM-VTON/result_train_v14/base_oficial
COMPACT_CHECKPOINT_ROOT=/home/uceda/Documents/IDM-VTON/result_train_v14/produccion_continua
LOG_ROOT=/home/uceda/Documents/IDM-VTON/logs/produccion_continua_v14
GARMENTNET_PATH=stabilityai/stable-diffusion-xl-base-1.0
IP_ADAPTER_PATH=ckpt/ip_adapter/ip-adapter-plus_sdxl_vit-h.bin
IMAGE_ENCODER_PATH=ckpt/image_encoder

# --- Rutas (PISTA B, comentadas; ajustar al stack limpio) --------------------
# BASE_CHECKPOINT=/ruta/a/sdxl-inpainting-comercial
# COMPACT_CHECKPOINT_ROOT=/home/uceda/Documents/IDM-VTON/result_train_v14b/salida
# LOG_ROOT=/home/uceda/Documents/IDM-VTON/logs/produccion_continua_v14b

# --- Rendimiento (medido en esta maquina: ~43 s/paso) ------------------------
CPU_THREADS=12                 # revierte OMP_NUM_THREADS=1 de accelerate
TRAIN_BATCH_SIZE=1             # 12 GB VRAM
TEST_BATCH_SIZE=1
TRAIN_NUM_WORKERS=1
TEST_NUM_WORKERS=1
WIDTH=448                      # entrenamiento actual; PISTA B: 576 (alinear con app)
HEIGHT=576                     # entrenamiento actual; PISTA B: 768
MIN_FREE_GIB=40                # el disco es el cuello de botella (93 GiB libres)
MIN_AVAILABLE_RAM_GIB=3        # 31 GiB totales + 15 GiB swap

# --- Bloque y continuidad ----------------------------------------------------
MAX_TRAIN_STEPS=500            # ~6,0 h por bloque
CHECKPOINTING_STEPS=100        # cada 100 pasos; PISTA B: 250 (menos disco)
LOGGING_STEPS=100
RESUME_OPTIMIZER_STATE=1       # continuidad real; ~3,4 GiB extra de RAM

# --- Optimizacion ------------------------------------------------------------
LEARNING_RATE=2e-5             # PISTA A. 5e-5 = riesgo; 1e-5 apenas mueve
# PISTA B recomendado: 1e-5 a 2e-5 + gradient_accumulation_steps 4-8

# --- Que se entrena ----------------------------------------------------------
# PISTA A (actual): solo IP-Adapter (14,17% de parametros) -> poca fidelidad.
#   El watchdog pasa --train_ip_adapter_only.
# PISTA B (recomendado): IP-Adapter + GarmentNet (unet_encoder), o LoRA sobre el
#   UNet. Requiere quitar --train_ip_adapter_only del script de lanzamiento.

# --- Augmentacion ------------------------------------------------------------
# ATENCION: el watchdog NO pasa ningun --color_jitter_*; se usan los defaults de
# train_xl.py: prob=0.5, brightness=0.2, contrast=0.2, saturation=0.2, hue=0.1.
# Para cambiarlos se edita el bloque de lanzamiento del watchdog. Valores PISTA B
# recomendados (una variable por experimento):
#   --color_jitter_prob=0.3
#   --color_jitter_brightness=0.15 --color_jitter_contrast=0.15
#   --color_jitter_saturation=0.15 --color_jitter_hue=0.0

# --- Calculadora de tiempo (plan_tiempo_v14.py) ------------------------------
SECONDS_PER_STEP=43.0          # medido 42,8; 43,0 conservador
STEPS_PER_BLOCK=500
OVERHEAD_H_PER_BLOCK=0.15
TRAIN_PAIRS=13563
BLOCK_DISK_GB=5.1
FREE_DISK_GB=93
