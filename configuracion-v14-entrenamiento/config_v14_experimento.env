# =============================================================================
# config_v14_experimento.env  -  IDM-VTON V14 (2026-09-10)
#
# Configuracion del BANCO DE EXPERIMENTOS de la Pista A (doc 04 de esta carpeta).
# Lo lee experimento_v14.sh. NO lo lee el watchdog ni produccion.
#
# Regla de oro (doc 04, 4.1): cambiar UNA variable por experimento y validar el
# resultado con el gate A/B (doc 04, 4.6) antes de acumular pasos.
# =============================================================================

# --- Rutas -------------------------------------------------------------------
PROJECT_ROOT=/home/uceda/Documents/IDM-VTON
DATA_DIR=/home/uceda/Documents/IDM-VTON/dataset/DATA_DIR_PREP
BASE_CHECKPOINT=/home/uceda/Documents/IDM-VTON/result_train_v14/base_oficial
GARMENTNET_PATH=stabilityai/stable-diffusion-xl-base-1.0
IP_ADAPTER_PATH=ckpt/ip_adapter/ip-adapter-plus_sdxl_vit-h.bin
IMAGE_ENCODER_PATH=ckpt/image_encoder
EXPERIMENT_ROOT=/home/uceda/Documents/IDM-VTON/result_train_v14/experimentos
EXPERIMENT_LOG_ROOT=/home/uceda/Documents/IDM-VTON/logs/experimentos_v14

# --- Que se entrena (doc 04, 4.2) --------------------------------------------
# C1 = solo IP-Adapter (lo que corre en produccion; fidelidad de prenda baja).
# C2 = IP-Adapter + GarmentNet: poner TRAIN_IP_ADAPTER_ONLY=1 y TRAIN_GARMENTNET=1.
# C3 = LoRA sobre el UNet: pendiente de implementar (necesita peft).
TRAIN_IP_ADAPTER_ONLY=1
TRAIN_GARMENTNET=0              # AVISO: exige que el GarmentNet quepa en VRAM; ver doc 10

# --- Hiperparametros (doc 04, 4.3) -------------------------------------------
TRAIN_BATCH_SIZE=1
TEST_BATCH_SIZE=1
TRAIN_NUM_WORKERS=1
TEST_NUM_WORKERS=1
GRADIENT_ACCUMULATION_STEPS=1
LEARNING_RATE=2e-5
MAX_GRAD_NORM=1.0
NUM_TOKENS=16
SEED=42

# --- Resolucion (doc 04, 4.5) ------------------------------------------------
# Produccion entrena a 448x576 e infiere a 576x768: la desalineacion es un candidato
# al artefacto. Un experimento util es 576x768 (sube el coste de RAM/tiempo).
WIDTH=448
HEIGHT=576

# --- Augmentacion (doc 04, 4.4) ----------------------------------------------
# El watchdog no pasa nada -> defaults de train_xl.py (prob 0.5, hue 0.1).
# Candidato principal al desplazamiento de color: hue 0.0.
COLOR_JITTER_ENABLED=1
COLOR_JITTER_PROB=0.3
COLOR_JITTER_BRIGHTNESS=0.15
COLOR_JITTER_CONTRAST=0.15
COLOR_JITTER_SATURATION=0.15
COLOR_JITTER_HUE=0.0

# --- Bloque del experimento --------------------------------------------------
MAX_TRAIN_STEPS=100             # gate 1 del doc 04; 500 para el gate 2
CHECKPOINTING_STEPS=100
LOGGING_STEPS=10

# --- Rendimiento / limites ---------------------------------------------------
CPU_THREADS=12
GARMENTNET_DTYPE=float32        # bfloat16 ahorra ~5,2 GiB de RAM (doc 09, opcion 2)
RESUME_OPTIMIZER_STATE=1
MIN_FREE_GIB=40

# --- Extra -------------------------------------------------------------------
# Argumentos crudos para el experimento concreto (se anaden al final).
EXTRA_ARGS=""
