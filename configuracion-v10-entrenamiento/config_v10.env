# Configuracion V10 - Perfilado de Tier 1 y busqueda de la mejor optimizacion.
# Estado: diagnostico con --profile_step_timing (solo mide, no cambia computo).
# Hereda de V7 la correccion RAM (low_cpu_mem_usage=True) y la correccion
# GARMENTNET_DTYPE=float32 (ver configuracion-v9-entrenamiento/03_APLICACION_FIX_A_V7.md).
# Objetivo: medir donde se va el tiempo extra de Tier1 (201s/paso) frente al
# baseline 100% CPU (128s/paso) y aplicar la mejor optimizacion encontrada.

SCHEMA_VERSION=1
LINE_ID=v10_line_001
PARENT_REVISION_ID=v7_line_001
MODE=warm_start_weights
PARENT_CHECKPOINT_ID=v4_run_20260822_101401/checkpoint-1
HYBRID_TIER=1

CONTINUATION_CHECKPOINT=/home/uceda/Documents/IDM-VTON/result_train_night/checkpoint-250
RESUME_CHECKPOINT=/home/uceda/Documents/IDM-VTON/result_train_v4/v4_run_20260822_101401/checkpoint-1
TRAINING_ROOT=/home/uceda/Documents/IDM-VTON/result_train_v10
LOG_ROOT=/home/uceda/Documents/IDM-VTON/logs/training_v10
DATA_DIR=/home/uceda/Documents/IDM-VTON/dataset/DATA_DIR_PREP
PRETRAINED_GARMENTNET_PATH=stabilityai/stable-diffusion-xl-base-1.0
PRETRAINED_IP_ADAPTER_PATH=ckpt/ip_adapter/ip-adapter-plus_sdxl_vit-h.bin
IMAGE_ENCODER_PATH=ckpt/image_encoder

TRAIN_WIDTH=448
TRAIN_HEIGHT=576
TRAIN_BATCH_SIZE=1
TEST_BATCH_SIZE=1
TRAIN_NUM_WORKERS=1
TEST_NUM_WORKERS=1
MIXED_PRECISION=fp16
LEARNING_RATE=1e-5
SEED=42

MAX_TRAIN_STEPS=1
CHECKPOINTING_STEPS=1
GARMENTNET_DTYPE=float32
RESUME_OPTIMIZER_STATE=0
MIN_FREE_GIB=90
MIN_FREE_RAM_GIB=6
PROFILE_STEP_TIMING=1
