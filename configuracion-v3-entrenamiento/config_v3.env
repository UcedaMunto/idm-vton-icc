# Configuracion canónica V3 para entrenamiento IDM-VTON.
CONTINUATION_CHECKPOINT=/home/uceda/Documents/IDM-VTON/result_train_night/checkpoint-250
TRAINING_ROOT=/home/uceda/Documents/IDM-VTON/result_train_v3
LOG_ROOT=/home/uceda/Documents/IDM-VTON/logs/training_v3
DATA_DIR=/home/uceda/Documents/IDM-VTON/dataset/DATA_DIR_PREP
PRETRAINED_GARMENTNET_PATH=stabilityai/stable-diffusion-xl-base-1.0
PRETRAINED_IP_ADAPTER_PATH=ckpt/ip_adapter/ip-adapter-plus_sdxl_vit-h.bin
IMAGE_ENCODER_PATH=ckpt/image_encoder

TRAIN_WIDTH=448
TRAIN_HEIGHT=576
TRAIN_BATCH_SIZE=1
TEST_BATCH_SIZE=1
# reducido tras OOM del sistema (RAM, no VRAM) durante guardado de checkpoint-5
TRAIN_NUM_WORKERS=1
TEST_NUM_WORKERS=1
MIXED_PRECISION=fp16
LEARNING_RATE=1e-5
SEED=42

# Smoke test V3: checkpoints completos recuperables al update 5 y 10.
MAX_TRAIN_STEPS=10
CHECKPOINTING_STEPS=5
MIN_FREE_GIB=90
