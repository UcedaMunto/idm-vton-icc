# Configuracion V6 - revision 1
# Estado: solo validacion. No se instala en cron ni se ejecuta automaticamente.
# Modo declarado explicitamente como warm_start_weights porque el checkpoint
# padre no incluye estado de optimizer ni RNG (ver hallazgo F-03).

SCHEMA_VERSION=1
LINE_ID=v6_line_001
PARENT_REVISION_ID=none
MODE=warm_start_weights
PARENT_CHECKPOINT_ID=v4_run_20260822_101401/checkpoint-1

CONTINUATION_CHECKPOINT=/home/uceda/Documents/IDM-VTON/result_train_night/checkpoint-250
RESUME_CHECKPOINT=/home/uceda/Documents/IDM-VTON/result_train_v4/v4_run_20260822_101401/checkpoint-1
TRAINING_ROOT=/home/uceda/Documents/IDM-VTON/result_train_v6
LOG_ROOT=/home/uceda/Documents/IDM-VTON/logs/training_v6
DATA_DIR=/home/uceda/Documents/IDM-VTON/dataset/DATA_DIR_PREP
PRETRAINED_GARMENTNET_PATH=stabilityai/stable-diffusion-xl-base-1.0
PRETRAINED_IP_ADAPTER_PATH=ckpt/ip_adapter/ip-adapter-plus_sdxl_vit-h.bin
IMAGE_ENCODER_PATH=ckpt/image_encoder

TRAIN_WIDTH=448
TRAIN_HEIGHT=576
TRAIN_BATCH_SIZE=1
TEST_BATCH_SIZE=1
TRAIN_NUM_WORKERS=1
TEST_NUM_WORKERS=1
MIXED_PRECISION=fp16
LEARNING_RATE=1e-5
SEED=42

# Bloque de validacion minimo, igual al ultimo perfil V4 aprobado.
MAX_TRAIN_STEPS=1
CHECKPOINTING_STEPS=1
GARMENTNET_DTYPE=bfloat16
RESUME_OPTIMIZER_STATE=0
MIN_FREE_GIB=90
MIN_FREE_RAM_GIB=4
