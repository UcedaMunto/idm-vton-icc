# Configuracion V4: proteger RAM del sistema y evitar ciclos infinitos de OOM.
CONTINUATION_CHECKPOINT=/home/uceda/Documents/IDM-VTON/result_train_night/checkpoint-250
TRAINING_ROOT=/home/uceda/Documents/IDM-VTON/result_train_v4
LOG_ROOT=/home/uceda/Documents/IDM-VTON/logs/training_v4
DATA_DIR=/home/uceda/Documents/IDM-VTON/dataset/DATA_DIR_PREP
PRETRAINED_GARMENTNET_PATH=stabilityai/stable-diffusion-xl-base-1.0
PRETRAINED_IP_ADAPTER_PATH=ckpt/ip_adapter/ip-adapter-plus_sdxl_vit-h.bin
IMAGE_ENCODER_PATH=ckpt/image_encoder

TRAIN_WIDTH=448
TRAIN_HEIGHT=576
TRAIN_BATCH_SIZE=1
TEST_BATCH_SIZE=1
TRAIN_NUM_WORKERS=1
TEST_NUM_WORKERS=1
MIXED_PRECISION=fp16
LEARNING_RATE=1e-5
SEED=42

# V4: bloque de validacion de un update; cambiar a 10 solo tras aprobarlo.
MAX_TRAIN_STEPS=1
CHECKPOINTING_STEPS=1
# Corregido a float32 (ver configuracion-v9-entrenamiento/03_APLICACION_FIX_A_V7.md):
# bfloat16 en CPU no tiene kernels eficientes y causaba ~14x mas tiempo por paso.
GARMENTNET_DTYPE=float32
RESUME_OPTIMIZER_STATE=0
MIN_FREE_GIB=90
